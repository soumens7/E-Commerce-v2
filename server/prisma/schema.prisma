generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  email     String   @unique
  password  String
  role      Int      @default(0)
  cart      Json     @default("[]")
  history   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  product_id  String   @unique
  title       String   @db.VarChar(255)
  price       Decimal  @db.Decimal(12, 2)
  description String   @db.VarChar(2000)
  content     String
  images      Json
  category    String
  checked     Boolean  @default(false)
  sold        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Order {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String
  orderId   String
  paymentId String
  amount    Decimal  @db.Decimal(12, 2)
  cart      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}